# Porta do servidor unificado (API Express + Frontend Vite)
PORT=3000

# Caminho do banco de dados SQLite local (criado e populado automaticamente no boot)
SQLITE_DB_PATH=./trustlink.db

# Chave para assinatura de Access Tokens JWT (altere em produção)
JWT_SECRET=trustlink-local-dev-secret-change-in-production

# Chave opcional da Maps JavaScript API para mapa interativo no Radar de Urgência
VITE_GOOGLE_MAPS_API_KEY=

